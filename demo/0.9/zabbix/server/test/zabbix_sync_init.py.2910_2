                            host_res = zabbix_client._api_json_request("host.get", {"hostids": hostid, "output": ["host"]})
                            host = host_res["result"][0]["host"]
                        else:
                            host = server_name   # or however you obtain the host name
                        escaped_key = item_key.replace(",", r"\,")
                        #res = zabbix_client._api_json_request("item.get", {"itemids": "70005", "output": ["itemid","key_","value_type","hostid"]})
                        #print(res)
                        #if value_type in ("0", "4"):   # numeric types (adjust according to your data)
                        #    expression = "{" + str(itemid) + ".last()}=2"
                        #else:
                        #    expression = "{" + str(itemid) + ".last()}=\"2\""
                        #expression = f"{{{itemid}.last()}}='2'"
                        if value_type == "1":
                            #expression = "{" + str(itemid) + ".last()}='2'"
                            expression = "{" + f"{server_name}:{escaped_key}.last()" + "}='2'"
                        else:
                            #expression = "{" + str(itemid) + ".last()}=2"
                            expression = "{" + f"{server_name}:{escaped_key}.last()" + "}=2"
                        print ("DEBUG: Expression print = ", expression)
                        print ("DEBUG: Expression repr = ", repr(expression))
                        create_trigger_params = {
                            "description": f"Problem with {description} on {server_name}",
                            "expression": expression,
                            "priority": "4",
                            "comments": f"Trigger for {plugin_name} check on {server_name}",
                            "status": "0"
                        }
                        print("DEBUG: params repr before call ->", repr(create_trigger_params))
                        try:
                            trigger_result = zabbix_client._api_request(
                                "trigger.get",
                                {
                                    "hostid": host_id,
                                    "search": {"description": create_trigger_params["description"]}
                                }
                            )
                            if not trigger_result["result"]:
                               # print("DEBUG: expr repr before call ->", repr(expression), type(expression))
                               # print("DEBUG: params repr before call ->", repr(create_trigger_params), type(create_trigger_params))
                               # params_as_list = [create_trigger_params]
                               # print("DEBUG: params_as_list repr ->", repr(params_as_list), type(params_as_list))
                                #result = zabbix_client._api_request("trigger.create", [create_trigger_params])
                                #resp = zabbix_client._api_request("trigger.create", [create_trigger_params])
                                # show exact expression characters for the item you are about to create trigger for
                                expr = create_trigger_params["expression"]
                                print("DEBUG: expression (print) ->", expr)
                                print("DEBUG: expression (repr)  ->", repr(expr))
                                print("DEBUG: expression type    ->", type(expr))
                                # show the item dict used to decide value_type and host
                                print("DEBUG: item used ->", repr(item_result["result"][0]))
                                try:
                                    #print("DEBUG: calling _api_request with dict")
                                    result = zabbix_client._api_request("trigger.create", [create_trigger_params])
                                    #print("DEBUG: Result A:", result)
                                except Exception as e:
                                    print("ERROR A:", repr(e))
                                    result = zabbix_client._api_request("trigger.create", create_trigger_params) 
                                if result and isinstance(result, dict) and result.get("result"):
                                    trigger_id = resp["result"]["triggerids"][0]
                                    logging.info(f"Created trigger: {plugin_name} on {server_name} (id {trigger_id})")
                                else:
                                    logging.error("Create failed, response: %r", resp)
                                #try:
                                #    print("DEBUG: calling _api_request with list")
                                #    res = zabbix_client._api_request("trigger.create", [create_trigger_params])
                                #    print("RESULT B:", res)
                                #except Exception as e:
                                #    print("ERROR B:", repr(e))
                                #try:
                                #    print("DEBUG: calling _api_request with dict")
                                #    res = zabbix_client._api_request("trigger.create", create_trigger_params)
                                #    print("RESULT C:", res)
                                #except Exception as e:
                                #    print("ERROR C:", repr(e))
                                #try:                                                                                                              
                                #    print("DEBUG: calling _api_request with list")                                                                
                                #    res = zabbix_client._api_request("trigger.create", [create_trigger_params])                                     
                                #    print("RESULT D:", res)                                                          
                                #except Exception as e:                                                           
                                #    print("ERROR D:", repr(e))
                                #trigger_id = result["result"]["triggerids"][0]
                                #logging.info(f"Created trigger: {plugin_name} on {server_name}")
                            else:
                                logging.info(f"Trigger exists: {plugin_name} on {server_name}")
                        except ZabbixSyncError as e:
                            logging.error(f"Failed to sync trigger {plugin_name}: {str(e)}")

                    else:
                        logging.info(f"Item exists: {description} on {server_name}")
                        
                except ZabbixSyncError as e:
                    logging.error(f"Failed to sync item {plugin_name}: {str(e)}")
        
    except Exception as e:
        logging.error(f"Sync failed: {str(e)}")
        raise

